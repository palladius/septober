#!/usr/bin/env python3
"""
septober-auto-banana — Automatic Nano-Banana Card Illustration Generator for Septober Todos.

Rule from Riccardo (2026-11-23):
- If an active todo note (name + description) has a reasonable size (> 150 bytes),
  automatically generate a Nano-Banana illustration (`gemini-2.5-flash-image`)
  tailored to its content and category color theme:
    * Work     -> Green / Emerald theme
    * Personal -> Yellow / Gold theme
    * Family   -> Pink / Rose theme
- Save to `septober_v8/public/auto_banana/todo_<id>.png` and update `photo_url` in SQLite.
"""

import base64
from concurrent.futures import ThreadPoolExecutor, as_completed
import json
import os
import sqlite3
import sys
import urllib.error
import urllib.request

DB_PATH = os.path.expanduser("~/git/septober/septober_v8/storage/development.sqlite3")
OUT_DIR = os.path.expanduser("~/git/septober/septober_v8/public/auto_banana")
MIN_BYTES = 150
MODEL = "gemini-2.5-flash-image"


def categorize_todo(name, desc, proj_name):
    import re
    blob = f"{name} {desc} {proj_name}".lower()
    if re.search(r"\b(sebi|ale|kids|pony|fotoquad|mounjaro|peclavus|podologa|casa|family|bimbi|cavalletto|cutie)\b", blob):
        return ("family", "warm pink, magenta, and rose accents on dark slate")
    if re.search(r"\b(hslu|slide|sre|distilleria|1ps|glossario|work|google|meeting|boss|stanford|osmani|verification|harness|semantic-router|litellm)\b", blob):
        return ("work", "vibrant emerald green and teal accents on dark slate")
    return ("personal", "warm golden yellow and amber accents on dark slate")


def generate_banana_for_todo(api_key, tid, name, desc, proj_name, force=False):
    os.makedirs(OUT_DIR, exist_ok=True)
    out_file = os.path.join(OUT_DIR, f"todo_{tid}.png")
    rel_url = f"/auto_banana/todo_{tid}.png"
    if os.path.exists(out_file) and os.path.getsize(out_file) > 1000 and not force:
        return (tid, rel_url, "cached")

    cat, palette = categorize_todo(name, desc, proj_name)
    prompt = (
        f"Create a sleek, modern, minimalist 16:9 vector card cover illustration for this task:\n"
        f"Title: {name}\n"
        f"Context: {desc[:300]}\n"
        f"Color Palette: {palette}.\n"
        f"Style: expressive editorial tech/lifestyle illustration, clean geometric shapes, subtle glowing highlights, NO TEXT or words inside the image."
    )

    url = f"https://generativelanguage.googleapis.com/v1beta/models/{MODEL}:generateContent?key={api_key}"
    payload = {
        "contents": [{"parts": [{"text": prompt}]}],
        "generationConfig": {"responseModalities": ["IMAGE", "TEXT"]},
    }
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=45) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        for cand in data.get("candidates", []):
            for part in cand.get("content", {}).get("parts", []):
                inline = part.get("inlineData") or part.get("inline_data")
                if inline and inline.get("data"):
                    img_bytes = base64.b64decode(inline["data"])
                    with open(out_file, "wb") as f:
                        f.write(img_bytes)
                    return (tid, rel_url, f"generated ({len(img_bytes)//1024}KB, {cat})")
        return (tid, None, "no_image_in_response")
    except Exception as e:
        return (tid, None, f"error: {e}")


def main():
    api_key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
    if not api_key:
        print("❌ GEMINI_API_KEY not found in environment", file=sys.stderr)
        sys.exit(1)

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute(
        """
        SELECT t.id, t.name, COALESCE(t.description, ''), COALESCE(p.name, 'personal'), COALESCE(t.photo_url, '')
        FROM todos t
        LEFT JOIN projects p ON p.id = t.project_id
        WHERE t.active = 1
        ORDER BY t.priority DESC, t.id DESC
        """
    )
    rows = cur.fetchall()

    eligible = []
    skipped = []
    for tid, name, desc, proj_name, photo_url in rows:
        nbytes = len((f"{name} {desc}").strip().encode("utf-8"))
        if nbytes > MIN_BYTES:
            eligible.append((tid, name, desc, proj_name, nbytes))
        else:
            skipped.append((tid, name, nbytes))

    print(f"🍌 AUTO-BANANA GENERATOR — Threshold: > {MIN_BYTES} bytes")
    print(f"   Eligible (> {MIN_BYTES}B): {len(eligible)} todos | Skipped (<= {MIN_BYTES}B): {len(skipped)} todos")
    for tid, name, nbytes in skipped:
        print(f"   ⏭️  Skip #{tid} [{nbytes}B <= {MIN_BYTES}B]: {name}")

    results = []
    with ThreadPoolExecutor(max_workers=6) as pool:
        futs = {
            pool.submit(generate_banana_for_todo, api_key, tid, name, desc, proj_name): (tid, name, nbytes)
            for (tid, name, desc, proj_name, nbytes) in eligible
        }
        for fut in as_completed(futs):
            tid, name, nbytes = futs[fut]
            _, rel_url, status = fut.result()
            print(f"   🎨 #{tid} [{nbytes}B] -> {status} | {name[:55]}")
            if rel_url:
                results.append((rel_url, tid))

    for rel_url, tid in results:
        cur.execute("UPDATE todos SET photo_url = ? WHERE id = ?", (rel_url, tid))
    conn.commit()
    conn.close()
    print(f"\n✅ Done! Updated {len(results)}/{len(eligible)} todos with Nano-Banana images in SQLite.")


if __name__ == "__main__":
    main()
