<%= turbo_frame_tag todo do %>
  <div class="todo-item <%= 'done' if todo.done? %>"
       data-controller="swipe"
       data-swipe-done-url-value="<%= done_todo_path(todo) %>"
       data-swipe-procrastinate-url-value="<%= procrastinate_todo_path(todo) %>"
       style="border-bottom: 1px solid #e5e7eb; padding: 0.75rem 0.5rem; display: flex; justify-content: space-between; align-items: flex-start; border-radius: 0.375rem; user-select: none; touch-action: pan-y; cursor: grab;">
    <div style="flex-grow: 1;">
      <div>
        <%= render_agent_first_row_icon(todo) if todo.user&.agent? %>
        <%= render_todo_icons(todo) %>
        <strong>
          <%= link_to todo.name, edit_todo_path(todo), data: { turbo_frame: dom_id(todo) }, style: "text-decoration: none; color: inherit;" %>
        </strong>
        <% if todo.project %>
          <span style="font-size: 0.8rem; color: <%= todo.project&.color.presence || '#6b7280' %>; font-weight: bold; margin-left: 4px;">
            <%= todo.project.name %>
          </span>
        <% end %>
         | <%= render_duetime(todo) %>
      </div>
      <div style="font-size: 0.8rem; color: #6b7280; margin-top: 4px;">
        <%= render_todo_second_row(todo) %>
      </div>
    </div>
    <div style="white-space: nowrap; margin-left: 10px; display: flex; gap: 4px;">
      <% unless todo.done? %>
        <%= link_to "Done", done_todo_path(todo), class: "btn btn-secondary", style: "font-size: 0.8rem; padding: 0.25rem 0.5rem;" %>
      <% else %>
        <%= link_to "Undone", undone_todo_path(todo), class: "btn btn-secondary", style: "font-size: 0.8rem; padding: 0.25rem 0.5rem; background-color: #9ca3af;" %>
      <% end %>
      <%= link_to "💤", procrastinate_todo_path(todo), class: "btn", title: "Procrastinate 7 days", style: "font-size: 0.8rem; padding: 0.25rem 0.5rem; background-color: #fef3c7;" %>
      <%= link_to "Edit", edit_todo_path(todo), class: "btn", style: "font-size: 0.8rem; padding: 0.25rem 0.5rem; background-color: #e5e7eb;", data: { turbo: false } %>
    </div>
  </div>
<% end %>
