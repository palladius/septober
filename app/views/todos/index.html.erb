<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h2>Todos</h2>
    <%= form_with url: todos_path, method: :get, local: true, style: "display: flex; gap: 0.5rem;" do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "Search todos...", style: "padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem;" %>
      <%= f.submit "Search", class: "btn btn-secondary" %>
    <% end %>
    <%= link_to "New Todo", new_todo_path, class: "btn btn-primary" %>
  </div>
  <div style="margin-bottom: 0.75rem; display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
    <strong>📁 Project:</strong>
    <%= link_to "All", todos_path(params.permit(:agent_id).merge(add_project: nil)), class: "btn btn-sm", style: "background-color: #{params[:add_project].blank? ? '#3b82f6' : '#e5e7eb'}; color: #{params[:add_project].blank? ? 'white' : '#374151'};" %>
    <% Project.where(user_id: current_user.family_user_ids).each do |proj| %>
      <%= link_to proj.name, todos_path(params.permit(:agent_id).merge(add_project: proj.name)), class: "btn btn-sm", style: "background-color: #{proj.color || '#e5e7eb'}; color: white; text-shadow: 0 1px 2px rgba(0,0,0,0.3);" %>
    <% end %>
  </div>

  <% if current_user&.agents&.any? %>
    <div style="margin-bottom: 0.75rem; display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
      <strong>🤖 Copilots:</strong>
      <%= link_to "All", todos_path(params.permit(:add_project).merge(agent_id: nil)), class: "btn btn-sm", style: "background-color: #{params[:agent_id].blank? ? '#4338ca' : '#e5e7eb'}; color: #{params[:agent_id].blank? ? 'white' : '#374151'};" %>
      <%= link_to "👤 #{current_user.username}", todos_path(params.permit(:add_project).merge(agent_id: current_user.id)), class: "btn btn-sm", style: "background-color: #{params[:agent_id].to_s == current_user.id.to_s ? '#4338ca' : '#e5e7eb'}; color: #{params[:agent_id].to_s == current_user.id.to_s ? 'white' : '#374151'};" %>
      <% current_user.agents.each do |agent| %>
        <%= link_to "#{agent.resolved_agent_icon} #{agent.username.split('.').last.capitalize}", todos_path(params.permit(:add_project).merge(agent_id: agent.id)), class: "btn btn-sm", style: "background-color: #{params[:agent_id].to_s == agent.id.to_s ? '#4338ca' : '#e5e7eb'}; color: #{params[:agent_id].to_s == agent.id.to_s ? 'white' : '#374151'};" %>
      <% end %>
    </div>
  <% end %>

  <div style="margin-bottom: 1rem; display: flex; justify-content: flex-end;">
    <small style="color: #9ca3af; font-style: italic;">👉 Swipe right to Complete | 👈 Swipe left to Snooze</small>
  </div>

  <div class="todos-list">
    <%= render @todos %>
  </div>
</div>
