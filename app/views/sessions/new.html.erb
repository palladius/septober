<div class="card" style="max-width: 400px; margin: 0 auto;">
  <h2>Login</h2>
  <%= form_with url: login_path, local: true do |f| %>
    <div class="form-group">
      <%= f.label :login, "Username or Email" %>
      <%= f.text_field :login, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :password %>
      <%= f.password_field :password, class: "form-control" %>
    </div>
    <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem;">
      <%= f.check_box :remember_me, checked: true, id: "remember_me" %>
      <%= f.label :remember_me, "Remember me on this Mac / Device", style: "margin-bottom: 0; font-weight: normal; cursor: pointer;" %>
    </div>
    <div class="form-group">
      <%= f.submit "Login", class: "btn btn-primary", style: "width: 100%;" %>
    </div>
  <% end %>
</div>
