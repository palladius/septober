<h1><%= render_user(@user) %></h1>

<p> Email: <%= on_the_spot_edit @user, :email %>
<p> Todos: <b><%= @user.todos.active.count %></b>/<%= @user.todos.count %> (<%= @user.todos.overdue.count %> overdue )
<p> Projects: <b><%= @user.projects.count %></b> (<%= @user.projects.publics.count %> public)
<p> Friends: TODO
<p> Admin?: <b><%= @user.admin? ? 'admin!!' : '-' %></b> 
	
<%# if @user.projects.publics %>
<h2>Public Projects</h2>

<% @user.projects.publics.each do |project| %>
	- <%= render_project(project) %> (<b><%= project.todos.active.count %></b>/<%= project.todos.count %> todos) <br/>
<%end%>

<% if @user.agents.any? %>
<hr/>
<h2>🤖 Autonomous Copilots & Agents</h2>
<ul>
  <% @user.agents.each do |agent| %>
    <li>
      <span style="font-size: 1.3em;"><%= agent.agent_icon || '🤖' %></span>
      <b><%= agent.username %></b> (Host: <code><%= agent.agent_host %></code>, <%= agent.todos.active.count %> active tasks)
    </li>
  <% end %>
</ul>
<% end %>