<% title "Update Profile" %>

<%= render 'form' %>

<hr/>

<div class='user_agents_section'>
  <h3>🤖 My Autonomous Copilots & Agents</h3>
  <% if @user.agents.any? %>
    <table border="1" cellpadding="6" cellspacing="0" class="agents_table" width="100%">
      <thead>
        <tr>
          <th>Icon</th>
          <th>Agent Username</th>
          <th>Host / Machine</th>
          <th>Email</th>
          <th>Tasks Count</th>
          <th>Created At</th>
        </tr>
      </thead>
      <tbody>
        <% @user.agents.each do |agent| %>
          <tr>
            <td align="center" style="font-size: 1.5em;"><%= agent.respond_to?(:resolved_agent_icon) ? agent.resolved_agent_icon : (agent.agent_icon || '🤖') %></td>
            <td><b><%= agent.username %></b></td>
            <td><code><%= agent.agent_host || 'cloud' %></code></td>
            <td><small><%= agent.email %></small></td>
            <td><%= agent.todos.count %> (<%= agent.todos.active.count %> active)</td>
            <td><small><%= agent.created_at.strftime('%Y-%m-%d') rescue '-' %></small></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p><i>No child agents registered yet.</i></p>
  <% end %>

  <br/>
  <h4>➕ Provision a New Sub-Agent</h4>
  <%= form_for User.new(:parent_id => @user.id, :is_agent => true), :url => users_path do |af| %>
    <%= af.hidden_field :parent_id, :value => @user.id %>
    <%= af.hidden_field :is_agent, :value => true %>
    <table border="0" cellpadding="4">
      <tr>
        <td><b>Agent Username:</b></td>
        <td><%= af.text_field :username, :placeholder => "palladius.macbook-air" %> <small>(e.g. palladius.&lt;name&gt;)</small></td>
      </tr>
      <tr>
        <td><b>Emoji Icon:</b></td>
        <td><%= af.text_field :agent_icon, :size => 4, :placeholder => "💻" %> <small>(e.g. 💻, 🦞, 🚛, 🐾, 🤖)</small></td>
      </tr>
      <tr>
        <td><b>Host / Machine:</b></td>
        <td><%= af.text_field :agent_host, :placeholder => "mini-lobby" %> <small>(e.g. mini-lobby, openclaw, cloudrun)</small></td>
      </tr>
      <tr>
        <td><b>Notification Email:</b></td>
        <td><%= af.text_field :email, :placeholder => "palladiusbonton+subagent@gmail.com" %></td>
      </tr>
      <tr>
        <td><b>Agent Password:</b></td>
        <td><%= af.password_field :password, :placeholder => "Secret agent password" %></td>
      </tr>
      <tr>
        <td><b>Confirm Password:</b></td>
        <td><%= af.password_field :password_confirmation, :placeholder => "Confirm password" %></td>
      </tr>
      <tr>
        <td></td>
        <td><%= af.submit "🚀 Provision Sub-Agent" %></td>
      </tr>
    </table>
  <% end %>

  <hr/>
  <h4>📖 How to Onboard & Connect your Sub-Agent</h4>
  <p>Once provisioned, configure the agent's environment (e.g. in <code>~/.hermes/.env</code> or <code>~/.openclaw/.env</code>):</p>
  <pre class="code_sample">
# In your agent's .env file:
SEPTOBER_USER="palladius.&lt;agent_name&gt;"
SEPTOBER_PASSWORD="&lt;agent_password&gt;"
SEPTOBER_AGENT="&lt;agent_name&gt;"

# For CLI usage:
septober-cli-26 --agent &lt;agent_name&gt; add --title "My task"
  </pre>
  <p><small>For complete instructions and troubleshooting, see <code>doc/AGENT_ONBOARDING.md</code> and skill <code>skills/septober/SKILL.md</code>.</small></p>
</div>


