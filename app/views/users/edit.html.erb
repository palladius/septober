<div class="card" style="max-width: 400px; margin: 0 auto;">
  <h2>Edit Profile</h2>
  <%= form_with model: @user, local: true do |f| %>
    <% if @user.errors.any? %>
      <div class="alert alert-danger">
        <ul>
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :username %>
      <%= f.text_field :username, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :description %>
      <%= f.text_area :description, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :password, "New Password (leave blank to keep current)" %>
      <%= f.password_field :password, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.submit "Update Profile", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<div class="card" style="max-width: 700px; margin: 2rem auto;">
  <h3>🤖 My Autonomous Copilots & Sub-Agents</h3>
  <% if @user.agents.any? %>
    <table border="0" cellpadding="8" cellspacing="0" width="100%" style="border-collapse: collapse; margin-top: 1rem;">
      <thead>
        <tr style="border-bottom: 2px solid #e5e7eb; text-align: left;">
          <th>Icon</th>
          <th>Agent Username</th>
          <th>Host</th>
          <th>Active Tasks</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <% @user.agents.each do |agent| %>
          <tr style="border-bottom: 1px solid #e5e7eb;">
            <td style="font-size: 1.5rem;"><%= agent.resolved_agent_icon %></td>
            <td><b><%= agent.username %></b></td>
            <td><code><%= agent.agent_host || 'cloud' %></code></td>
            <td><%= agent.todos.where(active: true).count %></td>
            <td><small><%= agent.created_at.strftime('%Y-%m-%d') rescue '-' %></small></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="color: #6b7280; font-style: italic;">No child agents registered yet.</p>
  <% end %>

  <hr style="margin: 1.5rem 0; border: none; border-top: 1px solid #e5e7eb;" />

  <h4>➕ Provision a New Sub-Agent</h4>
  <%= form_with model: User.new(parent_id: @user.id, is_agent: true), url: users_path, local: true do |af| %>
    <%= af.hidden_field :parent_id, value: @user.id %>
    <%= af.hidden_field :is_agent, value: true %>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
      <div class="form-group">
        <%= af.label :username, "Agent Username" %>
        <%= af.text_field :username, placeholder: "palladius.macbook", class: "form-control" %>
      </div>
      <div class="form-group">
        <%= af.label :agent_icon, "Emoji Icon" %>
        <%= af.text_field :agent_icon, placeholder: "💻, 🦞, 🚛, 🐾, 🤖", class: "form-control" %>
      </div>
      <div class="form-group">
        <%= af.label :agent_host, "Host / Machine" %>
        <%= af.text_field :agent_host, placeholder: "mini-lobby", class: "form-control" %>
      </div>
      <div class="form-group">
        <%= af.label :email, "Notification Email" %>
        <%= af.email_field :email, placeholder: "palladiusbonton+agent@gmail.com", class: "form-control" %>
      </div>
      <div class="form-group">
        <%= af.label :password, "Agent Password" %>
        <%= af.password_field :password, placeholder: "Secret password", class: "form-control" %>
      </div>
      <div class="form-group">
        <%= af.label :password_confirmation, "Confirm Password" %>
        <%= af.password_field :password_confirmation, placeholder: "Confirm password", class: "form-control" %>
      </div>
    </div>
    <div style="margin-top: 1rem;">
      <%= af.submit "🚀 Provision Sub-Agent", class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
