FROM gcr.io/ric-cccwiki/septober-mysql:2.3.12

WORKDIR /var/www/septober/
COPY config/database.yml /var/www/septober/config/database.yml
COPY app/controllers/application_controller.rb /var/www/septober/app/controllers/application_controller.rb
COPY app/controllers/todos_controller.rb /var/www/septober/app/controllers/todos_controller.rb
COPY app/controllers/api/todos_controller.rb /var/www/septober/app/controllers/api/todos_controller.rb
COPY app/helpers/todos_helper.rb /var/www/septober/app/helpers/todos_helper.rb
COPY app/models/todo.rb /var/www/septober/app/models/todo.rb
COPY app/models/user.rb /var/www/septober/app/models/user.rb
COPY app/views/todos/ /var/www/septober/app/views/todos/
COPY app/views/users/ /var/www/septober/app/views/users/
COPY app/views/layouts/ /var/www/septober/app/views/layouts/
RUN rm -f /var/www/septober/app/views/api/todos/create.json.builder
COPY bin/ /var/www/septober/bin/
COPY VERSION /var/www/septober/VERSION

RUN mkdir -p /var/www-public/septober/ && cp -r /var/www/septober/* /var/www-public/septober/ 2>/dev/null || true

WORKDIR /var/www/septober/
CMD ["./entrypoint-8080.sh"]
