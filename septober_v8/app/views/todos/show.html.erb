<%
  is_done    = @todo.done?
  is_overdue = (!is_done && @todo.overdue?)
  raw_url    = @todo.url.to_s.strip
  safe_url   = if raw_url.present? && raw_url !~ /\A\s*(javascript|data|vbscript):/i
                 raw_url =~ /\Ahttps?:\/\//i ? raw_url : "https://#{raw_url}"
               end
  parent_todo    = @todo.todo
  children_todos = Todo.where(user_id: @todo.user_id, depends_on_id: @todo.id).order(active: :desc, priority: :desc, id: :asc)
  progress_pct   = [[@todo.progress_status.to_i, 0].max, 100].min

  raw_desc = @todo.description.to_s.strip
  provenance = nil
  if raw_desc.sub!(/\n*\s*(Collected via [^\n]+)\z/m, "")
    provenance = $1.strip
  end
  clean_desc = raw_desc.strip
%>

<div class="max-w-4xl mx-auto py-4 px-2 space-y-4">
  <div class="card space-y-5">
    <!-- Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b" style="border-color: var(--border-subtle);">
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "← Tutti i Todo", todos_path, class: "btn text-xs" %>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold" style="background: var(--bg-even); border: 1px solid var(--border-subtle); color: var(--text-secondary);">#<%= @todo.id %></span>
        <% if is_done %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-500/15 text-slate-400">✓ Completato</span>
        <% elsif is_overdue %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-500/15 text-red-400 border border-red-500/40">● Scaduto</span>
        <% else %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">● Attivo</span>
        <% end %>
        <% if @todo.favorite %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-500/15 text-amber-400 border border-amber-500/30">★ Preferito</span>
        <% end %>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <% unless is_done %>
          <%= link_to "✓ Fatto", done_todo_path(@todo), class: "btn btn-secondary text-xs font-bold" %>
        <% else %>
          <%= link_to "↩ Riapri", undone_todo_path(@todo), class: "btn text-xs" %>
        <% end %>
        <%= link_to "✏️ Modifica", edit_todo_path(@todo), class: "btn btn-primary text-xs" %>
      </div>
    </div>

    <!-- Header -->
    <div class="space-y-2 min-w-0">
      <% if @todo.project %>
        <div class="text-xs font-semibold" style="color: var(--text-secondary);">
          📁 <%= link_to @todo.project.name, @todo.project, class: "hover:underline", style: "color: #{@todo.project.color.presence || 'var(--accent)'};" %>
        </div>
      <% end %>
      <h1 class="text-2xl font-extrabold leading-tight break-words <%= 'line-through opacity-60' if is_done %>" style="overflow-wrap: anywhere;">
        <%= @todo.name %>
      </h1>
      <% if @todo.tag_list.any? %>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <% @todo.tag_list.each do |tag| %>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-500/15 text-indigo-400 border border-indigo-500/25">#<%= tag %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Compact Clickable URL Pill (emoji only) -->
    <% if safe_url %>
      <div class="inline-flex flex-wrap items-center gap-2 px-3 py-1.5 rounded-lg border border-indigo-500/35 bg-indigo-500/10 max-w-full min-w-0" title="Link di riferimento">
        <span aria-hidden="true">🔗</span>
        <a href="<%= safe_url %>" target="_blank" rel="noopener noreferrer" class="text-xs sm:text-sm font-mono font-semibold text-indigo-400 hover:underline break-all min-w-0" style="overflow-wrap: anywhere;">
          <%= raw_url %> ↗
        </a>
      </div>
    <% end %>

    <!-- Description -->
    <div class="p-4 rounded-xl border min-w-0 space-y-3" style="background: var(--bg-odd); border-color: var(--border-subtle);">
      <div class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">📝 Contesto &amp; Descrizione</div>
      <% if clean_desc.present? %>
        <div class="text-base leading-relaxed whitespace-pre-wrap break-words" style="color: var(--text-primary); overflow-wrap: anywhere;"><%= clean_desc %></div>
      <% else %>
        <p class="text-sm italic" style="color: var(--text-muted);">Nessuna descrizione inserita.</p>
      <% end %>
      <% if provenance %>
        <div class="pt-2 border-t text-xs font-mono break-words" style="border-color: var(--border-subtle); color: var(--text-muted); overflow-wrap: anywhere;">
          📡 <%= provenance %>
        </div>
      <% end %>
    </div>

    <!-- Metadata Grid -->
    <%
      gp_map = {
        5 => { p: 0, code: "P0", label: "Critical", color: "#ef4444" },
        4 => { p: 1, code: "P1", label: "High",     color: "#f97316" },
        3 => { p: 2, code: "P2", label: "Normal",   color: "#eab308" },
        2 => { p: 3, code: "P3", label: "Low",      color: "#0ea5e9" },
        1 => { p: 4, code: "P4", label: "Backlog",  color: "#94a3b8" }
      }
      db_prio = [[@todo.priority.to_i, 1].max, 5].min
      pm = gp_map[db_prio]
      where_str = @todo.where.to_s.strip
      aerial_embed = where_str.present? ? "https://www.google.com/maps/embed?origin=mfe&pb=!1m4!2m1!1s#{CGI.escape(where_str).gsub('!', '%21')}!5e1!6i16" : nil
      ext_maps = where_str.present? ? "https://www.google.com/maps/search/?api=1&query=#{CGI.escape(where_str)}" : nil
    %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3" id="v8-meta-grid">
      <!-- Due Date (Red if past!) -->
      <div class="p-3.5 rounded-xl border min-w-0 <%= is_overdue ? 'bg-red-500/10 border-red-500/50' : '' %>" style="<%= 'background: var(--bg-odd); border-color: var(--border-subtle);' unless is_overdue %>">
        <div class="text-xs font-bold uppercase tracking-wider <%= is_overdue ? 'text-red-400' : '' %>" style="<%= 'color: var(--text-muted);' unless is_overdue %>">Scadenza (Due)</div>
        <div class="mt-1 font-bold text-sm <%= is_overdue ? 'text-red-500' : '' %>">
          <% if @todo.due.present? %>
            <% if is_overdue %>
              ⚠️ <%= @todo.due %> · Scaduto (<%= (Date.today - @todo.due.to_date).to_i %>g fa)
            <% else %>
              📅 <%= @todo.due %>
            <% end %>
          <% else %>
            <span style="color: var(--text-muted);">Nessuna scadenza</span>
          <% end %>
        </div>
      </div>

      <!-- Priority (Google P0..P4 Rotary Stops) -->
      <div class="p-3.5 rounded-xl border min-w-0 space-y-2" id="v8-prio-card" data-todo-id="<%= @todo.id %>" style="background: var(--bg-odd); border-color: var(--border-subtle); border-left: 3px solid <%= pm[:color] %>;">
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">Priorità (P0–P4)</span>
          <span id="v8-prio-status" class="text-[11px] font-mono font-bold text-emerald-400"></span>
        </div>
        <div class="font-extrabold text-sm" id="v8-prio-label" style="color: <%= pm[:color] %>;"><%= pm[:code] %> · <%= pm[:label] %> <span class="text-xs font-mono opacity-60">(DB <%= db_prio %>/5)</span></div>
        <div class="flex flex-wrap gap-1">
          <% [0, 1, 2, 3, 4].each do |gp| %>
            <% d = 5 - gp; m = gp_map[d] %>
            <button type="button" data-v8-gp="<%= gp %>" data-v8-db="<%= d %>" data-v8-color="<%= m[:color] %>" data-v8-code="<%= m[:code] %>" data-v8-label="<%= m[:label] %>" class="px-2 py-0.5 rounded text-xs font-mono font-bold border transition" style="border-color: <%= gp == pm[:p] ? m[:color] : 'var(--border-subtle)' %>; color: <%= gp == pm[:p] ? m[:color] : 'var(--text-secondary)' %>;"><%= m[:code] %></button>
          <% end %>
        </div>
      </div>

      <!-- Editable Progress Slider -->
      <div class="p-3.5 rounded-xl border min-w-0 space-y-2" id="v8-prog-card" data-todo-id="<%= @todo.id %>" style="background: var(--bg-odd); border-color: var(--border-subtle);">
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">Avanzamento</span>
          <span id="v8-prog-status" class="text-[11px] font-mono font-bold text-emerald-400"></span>
        </div>
        <div class="flex items-center gap-2">
          <input id="v8-prog-slider" type="range" min="0" max="100" step="5" value="<%= progress_pct %>" class="flex-1 cursor-pointer accent-indigo-500" />
          <span id="v8-prog-val" class="text-xs font-mono font-bold"><%= progress_pct %>%</span>
        </div>
      </div>

      <!-- Mini Aerial Google Maps (Expandable) -->
      <% if aerial_embed %>
        <div class="p-3.5 rounded-xl border min-w-0 space-y-2" id="v8-where-card" style="background: var(--bg-odd); border-color: var(--border-subtle);">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">Luogo (Where)</span>
            <button type="button" id="v8-map-toggle" class="px-2 py-0.5 rounded text-xs font-bold border hover:border-indigo-500" style="border-color: var(--border-subtle);">🔍 Espandi</button>
          </div>
          <div class="flex items-center justify-between gap-2 text-xs font-semibold">
            <span class="truncate">📍 <%= where_str %></span>
            <a href="<%= ext_maps %>" target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:underline shrink-0">Maps ↗</a>
          </div>
          <div id="v8-map-box" class="relative rounded-lg overflow-hidden border h-28 transition-all" style="border-color: var(--border-subtle);">
            <iframe src="<%= aerial_embed %>" class="w-full h-full border-0 pointer-events-none" id="v8-map-iframe" loading="lazy" title="Vista aerea <%= where_str %>"></iframe>
            <button type="button" id="v8-map-overlay" class="absolute inset-0 w-full h-full flex items-end justify-start p-1.5 bg-gradient-to-b from-transparent to-slate-950/70 text-[11px] font-bold text-white">🛰️ Clicca per espandere</button>
          </div>
        </div>
      <% end %>
    </div>

    <script>
      (function() {
        var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
        function patchTodo(id, fields, statusEl) {
          if (statusEl) statusEl.textContent = 'Salvo…';
          fetch('/todos/' + id + '.json', {
            method: 'PATCH',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrf },
            body: JSON.stringify({ todo: fields })
          }).then(function(r) {
            if (!r.ok) throw new Error();
            if (statusEl) { statusEl.textContent = '✓ Salvato'; setTimeout(function() { statusEl.textContent = ''; }, 1600); }
          }).catch(function() {
            if (statusEl) statusEl.textContent = '⚠ Errore';
          });
        }
        var slider = document.getElementById('v8-prog-slider');
        var valEl  = document.getElementById('v8-prog-val');
        var progCard = document.getElementById('v8-prog-card');
        if (slider && progCard) {
          slider.addEventListener('input', function() { valEl.textContent = slider.value + '%'; });
          slider.addEventListener('change', function() { patchTodo(progCard.dataset.todoId, { progress_status: parseInt(slider.value, 10) }, document.getElementById('v8-prog-status')); });
        }
        var prioCard = document.getElementById('v8-prio-card');
        if (prioCard) {
          prioCard.querySelectorAll('[data-v8-gp]').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var db = parseInt(btn.dataset.v8Db, 10);
              var col = btn.dataset.v8Color;
              prioCard.style.borderLeftColor = col;
              var lbl = document.getElementById('v8-prio-label');
              if (lbl) { lbl.style.color = col; lbl.innerHTML = btn.dataset.v8Code + ' · ' + btn.dataset.v8Label + ' <span class="text-xs font-mono opacity-60">(DB ' + db + '/5)</span>'; }
              patchTodo(prioCard.dataset.todoId, { priority: db }, document.getElementById('v8-prio-status'));
            });
          });
        }
        var whereCard = document.getElementById('v8-where-card');
        var mapBtn = document.getElementById('v8-map-toggle');
        var mapOverlay = document.getElementById('v8-map-overlay');
        var mapBox = document.getElementById('v8-map-box');
        var mapIframe = document.getElementById('v8-map-iframe');
        function toggleV8Map(forceOpen) {
          if (!whereCard) return;
          var exp = typeof forceOpen === 'boolean' ? forceOpen : !whereCard.classList.contains('lg:col-span-4');
          whereCard.classList.toggle('sm:col-span-2', exp);
          whereCard.classList.toggle('lg:col-span-4', exp);
          mapBox.classList.toggle('h-28', !exp);
          mapBox.classList.toggle('h-80', exp);
          mapIframe.classList.toggle('pointer-events-none', !exp);
          if (mapOverlay) mapOverlay.style.display = exp ? 'none' : '';
          if (mapBtn) mapBtn.textContent = exp ? '✕ Riduci' : '🔍 Espandi';
        }
        if (mapBtn) mapBtn.addEventListener('click', function() { toggleV8Map(); });
        if (mapOverlay) mapOverlay.addEventListener('click', function() { toggleV8Map(true); });
      })();
    </script>

    <!-- Dependencies -->
    <div class="p-4 rounded-xl border min-w-0 space-y-2" style="background: var(--bg-odd); border-color: var(--border-subtle);">
      <div class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">🧩 Dipendenze (Parent &amp; Children)</div>
      <% if parent_todo || children_todos.any? %>
        <div class="space-y-2">
          <% if parent_todo %>
            <div>
              <div class="text-xs mb-1" style="color: var(--text-secondary);">Parent:</div>
              <%= link_to "##{parent_todo.id} — #{parent_todo.name}", todo_path(parent_todo), class: "block p-2.5 rounded-lg border text-sm font-semibold hover:border-indigo-500 break-words", style: "background: var(--bg-surface); border-color: var(--border-subtle); overflow-wrap: anywhere;" %>
            </div>
          <% end %>
          <% if children_todos.any? %>
            <div class="space-y-1.5">
              <div class="text-xs mb-1" style="color: var(--text-secondary);">Children (<%= children_todos.size %>):</div>
              <% children_todos.each do |child| %>
                <%= link_to "##{child.id} — #{child.name}", todo_path(child), class: "block p-2.5 rounded-lg border text-sm font-semibold hover:border-indigo-500 break-words", style: "background: var(--bg-surface); border-color: var(--border-subtle); overflow-wrap: anywhere;" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs" style="color: var(--text-muted);">Nessuna dipendenza collegata.</p>
      <% end %>
    </div>

    <% if @todo.sys_notes.to_s.strip.present? %>
      <details class="p-3 rounded-lg border text-xs" style="background: var(--bg-odd); border-color: var(--border-subtle); color: var(--text-muted);">
        <summary class="cursor-pointer font-semibold">🛠 System &amp; Regex Debug Logs</summary>
        <pre class="mt-2 p-2.5 rounded font-mono text-xs whitespace-pre-wrap break-words overflow-y-auto max-h-56" style="background: var(--bg-page); overflow-wrap: anywhere;"><%= @todo.sys_notes.to_s.strip %></pre>
      </details>
    <% end %>
  </div>
</div>
