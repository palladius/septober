<%
  is_done    = @todo.done?
  is_overdue = (!is_done && @todo.overdue?)
  raw_url    = @todo.url.to_s.strip
  safe_url   = if raw_url.present? && raw_url !~ /\A\s*(javascript|data|vbscript):/i
                 raw_url =~ /\Ahttps?:\/\//i ? raw_url : "https://#{raw_url}"
               end
  parent_todo    = @todo.todo
  children_todos = Todo.where(user_id: @todo.user_id, depends_on_id: @todo.id).order(active: :desc, priority: :desc, id: :asc)
  progress_pct   = [[@todo.progress_status.to_i, 0].max, 100].min

  raw_desc = @todo.description.to_s.strip
  provenance = nil
  if raw_desc.sub!(/\n*\s*(Collected via [^\n]+)\z/m, "")
    provenance = $1.strip
  end
  clean_desc = raw_desc.strip
%>

<div class="max-w-4xl mx-auto py-4 px-2 space-y-4">
  <div class="card space-y-5">
    <!-- Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b" style="border-color: var(--border-subtle);">
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "← Tutti i Todo", todos_path, class: "btn text-xs" %>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold" style="background: var(--bg-even); border: 1px solid var(--border-subtle); color: var(--text-secondary);">#<%= @todo.id %></span>
        <% if is_done %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-500/15 text-slate-400">✓ Completato</span>
        <% elsif is_overdue %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-500/15 text-red-400 border border-red-500/40">● Scaduto</span>
        <% else %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">● Attivo</span>
        <% end %>
        <% if @todo.favorite %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-500/15 text-amber-400 border border-amber-500/30">★ Preferito</span>
        <% end %>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <% unless is_done %>
          <%= link_to "✓ Fatto", done_todo_path(@todo), class: "btn btn-secondary text-xs font-bold" %>
        <% else %>
          <%= link_to "↩ Riapri", undone_todo_path(@todo), class: "btn text-xs" %>
        <% end %>
        <%= link_to "✏️ Modifica", edit_todo_path(@todo), class: "btn btn-primary text-xs" %>
      </div>
    </div>

    <!-- Header -->
    <div class="space-y-2 min-w-0">
      <% if @todo.project %>
        <div class="text-xs font-semibold" style="color: var(--text-secondary);">
          📁 <%= link_to @todo.project.name, @todo.project, class: "hover:underline", style: "color: #{@todo.project.color.presence || 'var(--accent)'};" %>
        </div>
      <% end %>
      <h1 class="text-2xl font-extrabold leading-tight break-words <%= 'line-through opacity-60' if is_done %>" style="overflow-wrap: anywhere;">
        <%= @todo.name %>
      </h1>
      <% if @todo.tag_list.any? %>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <% @todo.tag_list.each do |tag| %>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-500/15 text-indigo-400 border border-indigo-500/25">#<%= tag %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Clickable URL Banner -->
    <% if safe_url %>
      <div class="p-3.5 rounded-xl border border-indigo-500/35 bg-indigo-500/10 flex flex-wrap items-center justify-between gap-2 min-w-0">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-300">🔗 URL</span>
        <a href="<%= safe_url %>" target="_blank" rel="noopener noreferrer" class="text-sm font-mono font-semibold text-indigo-400 hover:underline break-all min-w-0 flex-1" style="overflow-wrap: anywhere;">
          <%= raw_url %> ↗
        </a>
      </div>
    <% end %>

    <!-- Description -->
    <div class="p-4 rounded-xl border min-w-0 space-y-3" style="background: var(--bg-odd); border-color: var(--border-subtle);">
      <div class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">📝 Contesto &amp; Descrizione</div>
      <% if clean_desc.present? %>
        <div class="text-base leading-relaxed whitespace-pre-wrap break-words" style="color: var(--text-primary); overflow-wrap: anywhere;"><%= clean_desc %></div>
      <% else %>
        <p class="text-sm italic" style="color: var(--text-muted);">Nessuna descrizione inserita.</p>
      <% end %>
      <% if provenance %>
        <div class="pt-2 border-t text-xs font-mono break-words" style="border-color: var(--border-subtle); color: var(--text-muted); overflow-wrap: anywhere;">
          📡 <%= provenance %>
        </div>
      <% end %>
    </div>

    <!-- Metadata Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <!-- Due Date (Red if past!) -->
      <div class="p-3.5 rounded-xl border min-w-0 <%= is_overdue ? 'bg-red-500/10 border-red-500/50' : '' %>" style="<%= 'background: var(--bg-odd); border-color: var(--border-subtle);' unless is_overdue %>">
        <div class="text-xs font-bold uppercase tracking-wider <%= is_overdue ? 'text-red-400' : '' %>" style="<%= 'color: var(--text-muted);' unless is_overdue %>">Scadenza (Due)</div>
        <div class="mt-1 font-bold text-sm <%= is_overdue ? 'text-red-500' : '' %>">
          <% if @todo.due.present? %>
            <% if is_overdue %>
              ⚠️ <%= @todo.due %> · Scaduto (<%= (Date.today - @todo.due.to_date).to_i %>g fa)
            <% else %>
              📅 <%= @todo.due %>
            <% end %>
          <% else %>
            <span style="color: var(--text-muted);">Nessuna scadenza</span>
          <% end %>
        </div>
      </div>

      <!-- Priority -->
      <div class="p-3.5 rounded-xl border min-w-0" style="background: var(--bg-odd); border-color: var(--border-subtle);">
        <div class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">Priorità</div>
        <div class="mt-1 font-bold text-sm">P<%= @todo.priority %> / 5</div>
      </div>

      <!-- Progress -->
      <div class="p-3.5 rounded-xl border min-w-0" style="background: var(--bg-odd); border-color: var(--border-subtle);">
        <div class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">Avanzamento</div>
        <div class="mt-1.5 flex items-center gap-2">
          <div class="flex-1 h-2 rounded-full overflow-hidden" style="background: var(--bg-track);">
            <div class="h-full bg-indigo-500 rounded-full" style="width: <%= progress_pct %>%;"></div>
          </div>
          <span class="text-xs font-mono font-bold"><%= progress_pct %>%</span>
        </div>
      </div>
    </div>

    <!-- Dependencies -->
    <div class="p-4 rounded-xl border min-w-0 space-y-2" style="background: var(--bg-odd); border-color: var(--border-subtle);">
      <div class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">🧩 Dipendenze (Parent &amp; Children)</div>
      <% if parent_todo || children_todos.any? %>
        <div class="space-y-2">
          <% if parent_todo %>
            <div>
              <div class="text-xs mb-1" style="color: var(--text-secondary);">Parent:</div>
              <%= link_to "##{parent_todo.id} — #{parent_todo.name}", todo_path(parent_todo), class: "block p-2.5 rounded-lg border text-sm font-semibold hover:border-indigo-500 break-words", style: "background: var(--bg-surface); border-color: var(--border-subtle); overflow-wrap: anywhere;" %>
            </div>
          <% end %>
          <% if children_todos.any? %>
            <div class="space-y-1.5">
              <div class="text-xs mb-1" style="color: var(--text-secondary);">Children (<%= children_todos.size %>):</div>
              <% children_todos.each do |child| %>
                <%= link_to "##{child.id} — #{child.name}", todo_path(child), class: "block p-2.5 rounded-lg border text-sm font-semibold hover:border-indigo-500 break-words", style: "background: var(--bg-surface); border-color: var(--border-subtle); overflow-wrap: anywhere;" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs" style="color: var(--text-muted);">Nessuna dipendenza collegata.</p>
      <% end %>
    </div>

    <% if @todo.sys_notes.to_s.strip.present? %>
      <details class="p-3 rounded-lg border text-xs" style="background: var(--bg-odd); border-color: var(--border-subtle); color: var(--text-muted);">
        <summary class="cursor-pointer font-semibold">🛠 System &amp; Regex Debug Logs</summary>
        <pre class="mt-2 p-2.5 rounded font-mono text-xs whitespace-pre-wrap break-words overflow-y-auto max-h-56" style="background: var(--bg-page); overflow-wrap: anywhere;"><%= @todo.sys_notes.to_s.strip %></pre>
      </details>
    <% end %>
  </div>
</div>
