# Septober Next Configuration
# Copy to .env and customize

# API Key for agent access (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SEPTOBER_API_KEY=change-me-to-a-real-key

# Database URL (default: SQLite in project dir)
SEPTOBER_DB_URL=sqlite:///septober.db

# Server
SEPTOBER_HOST=0.0.0.0
SEPTOBER_PORT=8000

# Environment
SEPTOBER_ENV=development

# === Obsidian Sync Settings ===
# Gemini API key for LLM-powered todo triage (REQUIRED for obsidian-sync)
SEPTOBER_GEMINI_API_KEY=

# Septober API URL (for obsidian sync to POST to)
# Use http://localhost:8000 for dev, https://septober-xxx.run.app for prod
SEPTOBER_API_URL=http://localhost:8000

# obpbt command to run for todo extraction
SEPTOBER_OBPBT_CMD=obpbt todos

# Days after which travel items are considered stale
SEPTOBER_STALE_DAYS=14

# Gemini model for LLM triage
SEPTOBER_GEMINI_MODEL=gemini-2.0-flash
